# Copy to .env and fill in values. Never commit .env.

# API
PORT=3001

# Postgres
DATABASE_URL=postgresql://foundry:foundry@localhost:5432/foundry

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=                        # random 64-char hex: openssl rand -hex 32
ENCRYPTION_KEY=                    # random 32-byte hex: openssl rand -hex 32

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/v1/integrations/github/callback

# Web app URL (used for OAuth redirects)
APP_URL=http://localhost:5173
